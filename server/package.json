{
  "name": "splitstack-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "SplitStack backend REST API server (Node.js & Express)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/api.test.js\" \"tests/auth.test.js\" \"tests/models.test.js\" \"tests/receipts.test.js\" \"tests/server.test.js\"",
    "test:integration": "node --test tests/integration.test.js",
    "seed": "node scripts/seed.js --dev",
    "seed:test": "node scripts/seed.js --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "tesseract.js": "^7.0.0"
  }
}
